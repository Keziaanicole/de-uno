# Copy this file to .env and fill in both values from your Supabase project:
# Project Settings → API (or "Connect") → Project URL and Publishable / anon key.
# These are safe to ship in the app. The Anthropic API key never goes here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
